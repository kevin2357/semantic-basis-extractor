{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.local/schema/bounded-natal-cards-v1.json",
  "title": "AstroWoof Bounded Natal Final Cards v1",
  "type": "object",
  "required": ["schema_version", "editorial_status", "subject", "authority_notice", "cards", "summaries", "projected_term_registry"],
  "properties": {
    "schema_version": {"const": "astrowoof.bounded_natal.cards.v1"},
    "editorial_status": {"const": "complete"},
    "subject": {"type": "object"},
    "authority_notice": {"type": "object"},
    "cards": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/card"}
    },
    "summaries": {
      "type": "object",
      "required": ["summary_1", "summary_2", "summary_3", "summary_4"],
      "additionalProperties": false
    },
    "projected_term_registry": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "card": {
      "type": "object",
      "required": ["claim_id", "priority_id", "claim_kind", "editorial_tier", "invariant_authority", "evidence_provenance", "dos", "donts", "funny_dog_quotes", "imperative_dog_quotes", "applicable_canine_jokes", "densities"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "priority_id": {"type": "integer", "minimum": 1, "maximum": 50},
        "claim_kind": {"type": "string"},
        "editorial_tier": {"enum": ["foundational", "primary", "supporting", "supplemental"]},
        "invariant_authority": {"type": "object"},
        "evidence_provenance": {"type": "object"},
        "dos": {"type": "array", "minItems": 3, "maxItems": 3},
        "donts": {"type": "array", "minItems": 3, "maxItems": 3},
        "funny_dog_quotes": {"type": "array", "minItems": 1},
        "imperative_dog_quotes": {"type": "array", "minItems": 1},
        "applicable_canine_jokes": {"type": "array", "minItems": 1},
        "densities": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
