{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_v2_qualification.v1",
  "type": "object",
  "required": [
    "schema_version", "receipt_sha256", "status", "qualification_only",
    "provider_free", "external_network_call_count", "real_provider_create_count",
    "real_provider_retrieval_count", "provider_spend_usd", "sbe_version",
    "routes", "assertions"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_v2_qualification.v1"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "pass"},
    "qualification_only": {"const": true},
    "provider_free": {"const": true},
    "external_network_call_count": {"const": 0},
    "real_provider_create_count": {"const": 0},
    "real_provider_retrieval_count": {"const": 0},
    "provider_spend_usd": {"const": 0},
    "sbe_version": {"type": "string", "minLength": 1},
    "routes": {
      "type": "object",
      "required": ["exact_natal", "bounded_natal"],
      "properties": {
        "exact_natal": {"$ref": "#/$defs/route"},
        "bounded_natal": {"$ref": "#/$defs/route"}
      },
      "additionalProperties": false
    },
    "assertions": {
      "type": "object",
      "required": [
        "exact_holistic_4_plus_2_bridge", "bounded_holistic_4_plus_2_bridge",
        "ordinary_response_stage_matrix", "ordinary_batch_explicitly_deferred",
        "identity_before_next_create", "reconciliation_only_after_dispatch"
      ],
      "additionalProperties": {"const": true}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stageMap": {
      "type": "object",
      "required": ["creative_retry", "polish", "qualitative_critic", "qualitative_candidate"],
      "properties": {
        "creative_retry": {"type": "string"},
        "polish": {"type": "string"},
        "qualitative_critic": {"type": "string"},
        "qualitative_candidate": {"type": "string"}
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "route_family", "initial_create_count", "initial_create_unique_count",
        "retrieval_cycle_counts", "retrieval_count", "retrieval_unique_count",
        "ordinary_create_count", "stage_outcomes", "next_commands"
      ],
      "properties": {
        "route_family": {"enum": ["exact_natal", "bounded_natal"]},
        "initial_create_count": {"const": 6},
        "initial_create_unique_count": {"const": 6},
        "retrieval_cycle_counts": {"const": [4, 2]},
        "retrieval_count": {"const": 6},
        "retrieval_unique_count": {"const": 6},
        "ordinary_create_count": {"const": 4},
        "stage_outcomes": {
          "allOf": [
            {"$ref": "#/$defs/stageMap"},
            {"additionalProperties": {"const": "detached_provider_pending"}}
          ]
        },
        "next_commands": {
          "allOf": [
            {"$ref": "#/$defs/stageMap"},
            {"additionalProperties": {"const": "provider_reconciliation_cycle"}}
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
