{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.temporal_external_authority_contracts.v2",
  "title": "AstroWoof checkpoint-bound external-authority request",
  "type": "object",
  "required": [
    "schema_version", "external_authority_request_sha256", "run_id",
    "checkpoint_basis_sha256", "request_kind", "ordered_action_ids"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_request.v2"},
    "external_authority_request_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_basis_sha256": {
      "type": "string", "pattern": "^[0-9a-f]{64}$"
    },
    "request_kind": {"enum": ["ordinary_action_set", "initial_wave_admission"]},
    "ordered_action_ids": {
      "$comment": "ordinary_action_set members MUST be ascending lexical action_id order; enforced by the semantic validator",
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
    },
    "initial_wave": {"$ref": "#/$defs/initialWave"}
  },
  "allOf": [{
    "if": {"properties": {"request_kind": {"const": "initial_wave_admission"}}},
    "then": {
      "required": ["initial_wave"],
      "properties": {"ordered_action_ids": {"minItems": 6, "maxItems": 6}}
    }
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "initialWave": {
      "type": "object", "additionalProperties": false,
      "required": ["wave_id", "wave_sha256", "route_contract", "assignment_sha256", "profile_sha256", "member_count", "ordered_member_binding_sha256s"],
      "properties": {
        "wave_id": {"type": "string", "minLength": 1},
        "wave_sha256": {"$ref": "#/$defs/sha256"},
        "route_contract": {"const": "astrowoof.bounded_natal.authoring_run.v2"},
        "assignment_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "member_count": {"const": 6},
        "ordered_member_binding_sha256s": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  },
  "additionalProperties": false
}
