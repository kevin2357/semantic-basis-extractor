{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.example/contracts/sbe-worker-log.v1.schema.json",
  "title": "SBE worker application log v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "timestamp", "level", "event_name",
    "message", "logger", "function", "current_state", "correlation",
    "payload", "producer", "exception"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.sbe_worker_log.v1"},
    "record_type": {"const": "application_log"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "level": {"enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]},
    "event_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
    "message": {"type": "string", "minLength": 3, "maxLength": 2048, "pattern": "^✨🐶 "},
    "logger": {"type": "string", "minLength": 1, "maxLength": 256},
    "function": {"type": "string", "minLength": 1, "maxLength": 256},
    "current_state": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "correlation": {
      "type": "object", "additionalProperties": false,
      "required": ["api_run_id", "native_run_id", "subject_id", "invocation_id", "action_id", "provider_operation_id", "checkpoint_object_id"],
      "properties": {
        "api_run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "native_run_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "subject_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "invocation_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "action_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "provider_operation_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "checkpoint_object_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "payload": {"type": "object", "maxProperties": 64},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "host_id", "runtime_version"],
      "properties": {
        "service": {"const": "sbe-worker"},
        "host_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "runtime_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 128}
      }
    },
    "exception": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["exception_class", "classification_code", "fingerprint", "sanitized_message"],
          "properties": {
            "exception_class": {"type": "string", "minLength": 1, "maxLength": 128},
            "classification_code": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]{1,79}$"},
            "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "sanitized_message": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    }
  }
}
