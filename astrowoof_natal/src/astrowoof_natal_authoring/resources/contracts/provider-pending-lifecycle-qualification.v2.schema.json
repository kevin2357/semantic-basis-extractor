{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.provider_pending_lifecycle_qualification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "qualification_only", "provider_free", "network_required", "production_authority", "legacy_v1_receipt_sha256", "route_results", "assertions", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "astrowoof.provider_pending_lifecycle_qualification.v2"},
    "status": {"const": "pass"},
    "qualification_only": {"const": true},
    "provider_free": {"const": true},
    "network_required": {"const": false},
    "production_authority": {"const": false},
    "legacy_v1_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route_results": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route_family", "prior_operation_key", "prior_inventory_sha256", "successor_inventory_sha256", "successor_command", "successor_action_ids", "provider_create_count", "provider_retrieval_count", "replay_refused"],
        "properties": {
          "route_family": {"enum": ["exact_natal", "bounded_natal"]},
          "prior_operation_key": {"type": "string", "pattern": "^work_[0-9a-f]{24}$"},
          "prior_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "successor_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "successor_command": {"const": "await_external_authority"},
          "successor_action_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}},
          "provider_create_count": {"const": 0},
          "provider_retrieval_count": {"const": 0},
          "replay_refused": {"const": true}
        }
      }
    },
    "assertions": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
