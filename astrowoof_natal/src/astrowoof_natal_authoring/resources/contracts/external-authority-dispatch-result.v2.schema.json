{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_dispatch_result.v2",
  "type": "object",
  "required": [
    "schema_version", "result_sha256", "outcome", "run_id",
    "checkpoint_basis_sha256", "external_authority_request_sha256",
    "request_kind", "ordering_semantics", "ordered_action_ids", "reason_code",
    "selected_command", "dispatch_permitted", "native_mutation_performed",
    "provider_io_performed", "checkpoint_published"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_dispatch_result.v2"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {"const": "awaiting_compatible_grant"},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
    "external_authority_request_sha256": {"$ref": "#/$defs/sha256"},
    "request_kind": {"enum": ["ordinary_action_set", "initial_wave_admission"]},
    "ordering_semantics": {"enum": ["lexical_action_id_ascending", "prepared_wave_semantic_member_order"]},
    "ordered_action_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/actionId"}
    },
    "reason_code": {"const": "compatible_grant_required"},
    "selected_command": {"const": "none"},
    "dispatch_permitted": {"const": false},
    "native_mutation_performed": {"const": false},
    "provider_io_performed": {"const": false},
    "checkpoint_published": {"const": false},
    "initial_wave": {"$ref": "#/$defs/initialWave"}
  },
  "allOf": [{
    "if": {"properties": {"request_kind": {"const": "initial_wave_admission"}}},
    "then": {"required": ["initial_wave"], "properties": {"ordering_semantics": {"const": "prepared_wave_semantic_member_order"}, "ordered_action_ids": {"minItems": 6, "maxItems": 6}}}
  }],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionId": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"},
    "initialWave": {
      "type": "object", "additionalProperties": false,
      "required": ["wave_id", "wave_sha256", "route_contract", "assignment_sha256", "profile_sha256", "member_count", "ordered_member_binding_sha256s"],
      "properties": {
        "wave_id": {"type": "string", "minLength": 1}, "wave_sha256": {"$ref": "#/$defs/sha256"},
        "route_contract": {"const": "astrowoof.bounded_natal.authoring_run.v2"}, "assignment_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"}, "member_count": {"const": 6},
        "ordered_member_binding_sha256s": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/sha256"}}
      }
    }
  }
}
