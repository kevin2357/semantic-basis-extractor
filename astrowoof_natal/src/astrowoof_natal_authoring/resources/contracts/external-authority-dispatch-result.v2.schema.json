{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_dispatch_result.v2",
  "type": "object",
  "required": [
    "schema_version", "result_sha256", "outcome", "run_id",
    "checkpoint_basis_sha256", "external_authority_request_sha256",
    "request_kind", "ordering_semantics", "ordered_action_ids", "reason_code",
    "selected_command", "dispatch_permitted", "native_mutation_performed",
    "provider_io_performed", "checkpoint_published"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_dispatch_result.v2"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {"const": "awaiting_compatible_grant"},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
    "external_authority_request_sha256": {"$ref": "#/$defs/sha256"},
    "request_kind": {"const": "ordinary_action_set"},
    "ordering_semantics": {"const": "lexical_action_id_ascending"},
    "ordered_action_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/actionId"}
    },
    "reason_code": {"const": "compatible_grant_required"},
    "selected_command": {"const": "none"},
    "dispatch_permitted": {"const": false},
    "native_mutation_performed": {"const": false},
    "provider_io_performed": {"const": false},
    "checkpoint_published": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionId": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
  }
}
