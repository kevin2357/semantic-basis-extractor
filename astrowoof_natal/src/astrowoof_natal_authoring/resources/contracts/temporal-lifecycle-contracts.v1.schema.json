{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.temporal_lifecycle_contracts.v1",
  "title": "AstroWoof checkpoint-basis and temporal-decision lifecycle contract",
  "type": "object",
  "required": [
    "schema_version", "run_id", "checkpoint_basis_sha256",
    "checkpoint_basis", "temporal_decision_sha256", "temporal_decision"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.authoring_lifecycle_inspection.v0.6"},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_basis": {"$ref": "#/$defs/checkpointBasis"},
    "temporal_decision_sha256": {"$ref": "#/$defs/sha256"},
    "temporal_decision": {"$ref": "#/$defs/temporalDecision"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionId": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"},
    "canonicalUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "checkpointBasis": {
      "type": "object",
      "required": [
        "observation", "terminal", "quiescence", "local_dependencies",
        "action_inventory", "review_reasons", "provider_custody",
        "native_route", "consumer_authority",
        "checkpoint_safe_for_worker_release", "reconciliation_policy_version",
        "external_authority_state"
      ],
      "properties": {
        "observation": {"type": "object"},
        "terminal": {"type": "object"},
        "quiescence": {"type": "object"},
        "local_dependencies": {"type": "array"},
        "action_inventory": {"type": "object"},
        "review_reasons": {"type": "array", "uniqueItems": true},
        "provider_custody": {"type": "object"},
        "native_route": {"type": "object"},
        "consumer_authority": {"type": "object"},
        "checkpoint_safe_for_worker_release": {"type": "boolean"},
        "reconciliation_policy_version": {"const": "astrowoof.provider_reconciliation_policy.v0.2"},
        "external_authority_state": {"$ref": "#/$defs/externalAuthorityState"}
      },
      "additionalProperties": false
    },
    "externalAuthorityState": {
      "type": "object",
      "required": [
        "kind", "request_kind", "ordered_action_ids", "refusal_reason",
        "evidence_categories"
      ],
      "properties": {
        "kind": {"enum": ["none", "request", "refusal"]},
        "request_kind": {"type": ["string", "null"]},
        "ordered_action_ids": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/actionId"}
        },
        "refusal_reason": {"type": ["string", "null"]},
        "evidence_categories": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "temporalDecision": {
      "type": "object",
      "required": [
        "observed_at", "checkpoint_basis_sha256", "capacity_disposition",
        "local_work_ready_now", "reason_code", "selected_command",
        "eligible_now", "due_action_ids", "not_before"
      ],
      "properties": {
        "observed_at": {"$ref": "#/$defs/canonicalUtc"},
        "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
        "capacity_disposition": {"type": "string", "minLength": 1},
        "local_work_ready_now": {"type": "boolean"},
        "reason_code": {"type": "string", "minLength": 1},
        "selected_command": {"type": "string", "minLength": 1},
        "eligible_now": {"type": "boolean"},
        "due_action_ids": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/actionId"}
        },
        "not_before": {"oneOf": [{"$ref": "#/$defs/canonicalUtc"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  }
}
