{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_provider_dispatch_result.v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_sha256", "outcome", "reason_code",
    "provider_io_disposition", "grant_invocation_disposition", "run_id",
    "request_sha256", "grant_sha256", "ordered_action_ids",
    "provider_bound_action_ids", "ambiguous_action_ids", "refused_action_ids",
    "provider_operation_ids", "prepared_create_records", "post_state_revision",
    "post_snapshot_sha256"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_provider_dispatch_result.v5"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"const": "pre_provider_refusal"},
    "reason_code": {"const": "completed_intent_retirement_required"},
    "provider_io_disposition": {"const": "not_attempted"},
    "grant_invocation_disposition": {"const": "refused"},
    "run_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grant_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ordered_action_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
    },
    "provider_bound_action_ids": {"const": []},
    "ambiguous_action_ids": {"const": []},
    "refused_action_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
    },
    "provider_operation_ids": {"const": []},
    "prepared_create_records": {"const": []},
    "post_state_revision": {"type": "integer", "minimum": 1},
    "post_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
