{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_intent_result.v2",
  "type": "object",
  "required": [
    "schema_version", "result_sha256", "outcome", "run_id",
    "request_sha256", "grant_sha256", "ordered_action_ids",
    "pre_state_revision", "post_state_revision", "post_snapshot_sha256",
    "provider_io_performed"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_intent_result.v2"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "outcome": {"const": "intent_committed"},
    "run_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "grant_sha256": {"$ref": "#/$defs/sha256"},
    "ordered_action_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/actionId"}
    },
    "pre_state_revision": {"type": "integer", "minimum": 0},
    "post_state_revision": {"type": "integer", "minimum": 1},
    "post_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "provider_io_performed": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionId": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
  }
}
