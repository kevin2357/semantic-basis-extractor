{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.initial_authoring_wave_binding_bundle.v1",
  "type": "object",
  "required": [
    "schema_version", "bundle_sha256", "wave_id", "wave_sha256", "run_id",
    "route_family", "profile_sha256", "preparation_basis_revision",
    "price_book_version", "member_count", "ordered_members",
    "aggregate_maximum_commitment_micro_usd"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.initial_authoring_wave_binding_bundle.v1"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "wave_id": {"type": "string", "pattern": "^wave_[0-9a-f]{24}$"},
    "wave_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "route_family": {"enum": ["exact_natal", "bounded_natal"]},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "preparation_basis_revision": {"type": "integer", "minimum": 0},
    "price_book_version": {"type": "string", "minLength": 1},
    "member_count": {"const": 6},
    "ordered_members": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
    "aggregate_maximum_commitment_micro_usd": {"type": "integer", "minimum": 6}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["run_id", "profile_sha256", "prepared_state_revision", "stage", "route", "request_sha256", "model", "service_level", "maximum_output_tokens", "commitment_micro_usd", "price_book_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "prepared_state_revision": {"type": "integer", "minimum": 0},
        "stage": {"const": "authoring_initial"},
        "route": {"type": "string", "minLength": 1},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "model": {"type": "string", "minLength": 1},
        "service_level": {"const": "interactive"},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "commitment_micro_usd": {"type": "integer", "minimum": 1},
        "price_book_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["action_id", "pass_id", "pass_number", "binding", "binding_sha256"],
      "properties": {
        "action_id": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"},
        "pass_id": {"type": "string", "minLength": 1},
        "pass_number": {"type": "integer", "minimum": 1, "maximum": 6},
        "binding": {"$ref": "#/$defs/binding"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
