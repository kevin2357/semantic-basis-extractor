{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.example/contracts/sbe-trace-observability-qualification.v1.schema.json",
  "title": "SBE trace observability qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sbe_release", "provider_mode", "external_network_calls",
    "provider_create_calls", "provider_retrieval_calls", "routes", "privacy",
    "sink_failure_isolated", "qualification_sha256"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.sbe_trace_observability_qualification.v1"},
    "sbe_release": {"type": "string", "minLength": 1},
    "provider_mode": {"const": "provider_free"},
    "external_network_calls": {"const": 0},
    "provider_create_calls": {"const": 0},
    "provider_retrieval_calls": {"const": 0},
    "routes": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "route_family", "selected_command", "required_trace_units",
          "trace_shape_sha256", "stderr_line_count", "public_schema_version"
        ],
        "properties": {
          "route_family": {"enum": ["exact_natal", "bounded_natal"]},
          "selected_command": {"type": "string", "minLength": 1},
          "required_trace_units": {
            "const": [
              "workspace_fingerprint", "native_state_summary",
              "native_decision_summary", "command_exit"
            ]
          },
          "trace_shape_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stderr_line_count": {"type": "integer", "minimum": 4},
          "public_schema_version": {"type": "string", "minLength": 1}
        }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "protected_sentinel_absent", "absolute_workspace_path_absent",
        "credentials_absent", "payloads_absent"
      ],
      "properties": {
        "protected_sentinel_absent": {"const": true},
        "absolute_workspace_path_absent": {"const": true},
        "credentials_absent": {"const": true},
        "payloads_absent": {"const": true}
      }
    },
    "sink_failure_isolated": {"const": true},
    "qualification_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
