{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.dev/contracts/ordinary-v2-happy-path-bundle.v1.schema.json",
  "title": "AstroWoof ordinary v2 happy-path public bundle v1",
  "type": "object",
  "required": ["schema_version", "bundle_sha256", "fixture_sha256", "qualification_receipt_sha256", "witnesses"],
  "properties": {
    "schema_version": {"const": "astrowoof.ordinary_v2_happy_path_bundle.v1"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualification_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "witnesses": {"type": "array", "minItems": 2, "maxItems": 2}
  },
  "additionalProperties": false
}
