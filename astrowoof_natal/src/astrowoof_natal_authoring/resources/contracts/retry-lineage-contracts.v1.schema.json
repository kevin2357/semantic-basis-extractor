{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://astrowoof.example/contracts/retry-lineage-contracts.v1.schema.json",
  "title":"AstroWoof retry-lineage contract family v1",
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "actionId":{"type":"string","pattern":"^paid_[0-9a-f]{24}$"},
    "coordinates":{"type":"object","additionalProperties":false,"required":["native_run_id","route_family","stage","pass_id","attempt_number"],"properties":{"native_run_id":{"type":"string","minLength":1},"route_family":{"enum":["exact_natal","bounded_natal"]},"stage":{"enum":["authoring_initial","creative_retry","polish","qualitative_critic","qualitative_candidate"]},"pass_id":{"type":"string","minLength":1},"attempt_number":{"type":"integer","minimum":1}}},
    "action":{"type":"object","additionalProperties":false,"required":["action_id","binding_sha256","request_sha256","state","provider_mechanism","provider_operation_id","pass_attempt_pointer"],"properties":{"action_id":{"$ref":"#/$defs/actionId"},"binding_sha256":{"$ref":"#/$defs/sha"},"request_sha256":{"$ref":"#/$defs/sha"},"state":{"enum":["PREPARED","AUTHORIZED","SUBMITTING","PROVIDER_ID_RECORDED","WAITING","REPORTED","DENIED_PROVIDERLESS","BUDGET_EXHAUSTED","SKIPPED_BUDGET_EXHAUSTED","AMBIGUOUS_PROVIDER_SUBMISSION"]},"provider_mechanism":{"enum":["response","batch"]},"provider_operation_id":{"type":["string","null"]},"pass_attempt_pointer":{"type":"string","minLength":1}}},
    "inventory":{"type":"object","additionalProperties":false,"required":["schema_version","run_id","ordering_semantics","attempts","status","conflict_classification","forward_dispatch_permitted","reconciliation_permitted","inventory_sha256"],"properties":{"schema_version":{"const":"astrowoof.retry_lineage_inventory.v1"},"run_id":{"type":"string","minLength":1},"ordering_semantics":{"const":"lexical_attempt_key_then_action_id"},"attempts":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["attempt_key","coordinates","resolution","selected_action_id","actions","reason_codes"],"properties":{"attempt_key":{"type":"string","pattern":"^attempt_[0-9a-f]{24}$"},"coordinates":{"$ref":"#/$defs/coordinates"},"resolution":{"enum":["consistent","conflict"]},"selected_action_id":{"anyOf":[{"$ref":"#/$defs/actionId"},{"type":"null"}]},"actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"}},"reason_codes":{"type":"array","uniqueItems":true,"items":{"enum":["multiple_actions_for_attempt","request_binding_conflict","pass_attempt_pointer_conflict","multiple_active_actions_for_attempt"]}}}}},"status":{"enum":["consistent","conflict"]},"conflict_classification":{"enum":["retry_lineage_conflict_requires_review",null]},"forward_dispatch_permitted":{"type":"boolean"},"reconciliation_permitted":{"type":"boolean"},"inventory_sha256":{"$ref":"#/$defs/sha"}}}
  },
  "$ref":"#/$defs/inventory"
}
