{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.dev/contracts/sbe-run-cohort-timeline-qualification.v1.schema.json",
  "title": "AstroWoof SBE cohort-timeline qualification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_sha256", "timeline_sha256", "html_sha256",
    "run_count", "final_postures", "witnessed_handoff_duration_ms",
    "open_interval_count", "no_progress_candidate_count", "provider_call_count"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.sbe_run_cohort_timeline_qualification.v1"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "html_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_count": {"const": 3},
    "final_postures": {
      "type": "object", "additionalProperties": false,
      "required": ["delivered", "terminal_review"],
      "properties": {"delivered": {"const": 2}, "terminal_review": {"const": 1}}
    },
    "witnessed_handoff_duration_ms": {"const": 102},
    "open_interval_count": {"type": "integer", "minimum": 1},
    "no_progress_candidate_count": {"type": "integer", "minimum": 1},
    "provider_call_count": {"const": 0}
  }
}
