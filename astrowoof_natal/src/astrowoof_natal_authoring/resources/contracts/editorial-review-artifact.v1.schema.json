{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.editorial_review_artifact.v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "artifact_sha256", "artifact_kind", "object_sha256", "media_type", "native_correlations", "relations"],
  "properties": {
    "schema_version": {"const": "editorial_review_artifact.v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_kind": {"enum": ["assembled_deck", "provider_response"]},
    "object_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "media_type": {"const": "application/json"},
    "native_correlations": {
      "type": "object", "additionalProperties": false,
      "required": ["native_run_id", "subject_id", "packet_id"],
      "properties": {
        "native_run_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "packet_id": {"type": "string", "minLength": 1}
      }
    },
    "relations": {
      "type": "object", "additionalProperties": false,
      "required": ["uses"],
      "properties": {
        "uses": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role"],
            "properties": {
              "role": {"enum": ["initial_assembled", "decision_input", "materialized_candidate", "decision_output", "terminal_selected", "delivered", "provider_response"]},
              "decision_id": {"type": "string", "minLength": 1},
              "stage": {"enum": ["initial_pass", "creative_retry", "polish", "critic", "candidate"]},
              "stage_attempt": {"type": "integer", "minimum": 1},
              "paid_action_id": {"type": "string", "minLength": 1},
              "binding_id": {"type": "string", "minLength": 1},
              "provider_response_id": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "assembled_deck": {},
    "provider_response": {}
  },
  "oneOf": [
    {"properties": {"artifact_kind": {"const": "assembled_deck"}}, "required": ["assembled_deck"], "not": {"required": ["provider_response"]}},
    {"properties": {"artifact_kind": {"const": "provider_response"}}, "required": ["provider_response"], "not": {"required": ["assembled_deck"]}}
  ]
}
