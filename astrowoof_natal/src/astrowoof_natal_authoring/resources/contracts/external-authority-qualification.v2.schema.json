{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_qualification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_sha256", "status", "qualification_only",
    "provider_free", "network_required", "production_authority", "sbe_version",
    "assertions", "fixture_hashes", "provider_create_count", "provider_spend_usd"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_qualification.v2"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "pass"},
    "qualification_only": {"const": true},
    "provider_free": {"const": true},
    "network_required": {"const": false},
    "production_authority": {"const": false},
    "sbe_version": {"type": "string", "minLength": 1},
    "provider_create_count": {"const": 6},
    "provider_spend_usd": {"const": 0},
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_initial_admission", "fresh_worker_restore", "retained_exact_replay",
        "conflicting_lineage_refusal", "stale_request_refusal",
        "ordinary_action_authorization", "reconciliation_separated_from_create",
        "lifecycle_conditionals_enforced", "typed_refusal_conditionals_enforced"
      ],
      "properties": {
        "fresh_initial_admission": {"const": true},
        "fresh_worker_restore": {"const": true},
        "retained_exact_replay": {"const": true},
        "conflicting_lineage_refusal": {"const": true},
        "stale_request_refusal": {"const": true},
        "ordinary_action_authorization": {"const": true},
        "reconciliation_separated_from_create": {"const": true},
        "lifecycle_conditionals_enforced": {"const": true},
        "typed_refusal_conditionals_enforced": {"const": true}
      }
    },
    "fixture_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_request", "aggregate_grant", "lineage_refusal", "ordinary_request"
      ],
      "properties": {
        "initial_request": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "aggregate_grant": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "lineage_refusal": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ordinary_request": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
