{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.example/contracts/native-cooperative-suspension-contracts.v1.schema.json",
  "title": "AstroWoof native cooperative-suspension contracts v1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["state_revision", "snapshot_sha256", "checkpoint_basis_sha256", "predecessor_checkpoint_basis_sha256"],
      "properties": {
        "state_revision": {"type": "integer", "minimum": 0},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
        "predecessor_checkpoint_basis_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "action_id", "binding_sha256", "native_action_state", "provider_operation_id", "custody_class"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 128},
        "action_id": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "native_action_state": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider_operation_id": {"type": ["string", "null"]},
        "custody_class": {"enum": ["none", "provider_pending", "completed_unadopted", "provider_ambiguous", "providerless_authority", "terminally_accounted"]}
      }
    },
    "supervision_invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "supervision_invocation_id", "launch_generation", "api_run_id", "job_id", "attempt_id", "lease_id", "lease_token_sha256", "native_run_id", "worker_boot_id", "command_kind", "command_sha256", "executable_workspace_root", "executable_workspace_root_sha256", "control_root", "control_root_sha256", "created_at", "launch_not_after", "grace_deadline", "supervision_capability_id", "supervision_capability_sha256", "envelope_sha256"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_supervision_invocation.v1"},
        "supervision_invocation_id": {"type": "string", "minLength": 1},
        "launch_generation": {"type": "integer", "minimum": 1},
        "api_run_id": {"type": "string", "minLength": 1}, "job_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1}, "lease_id": {"type": "string", "minLength": 1},
        "lease_token_sha256": {"$ref": "#/$defs/sha256"}, "native_run_id": {"type": "string", "minLength": 1},
        "worker_boot_id": {"type": "string", "minLength": 1},
        "command_kind": {"enum": ["external_authority_v2_dispatch", "provider_reconciliation"]},
        "command_sha256": {"$ref": "#/$defs/sha256"}, "executable_workspace_root": {"type": "string", "minLength": 1},
        "executable_workspace_root_sha256": {"$ref": "#/$defs/sha256"}, "control_root": {"type": "string", "minLength": 1},
        "control_root_sha256": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string"},
        "launch_not_after": {"type": "string"}, "grace_deadline": {"type": "string"},
        "supervision_capability_id": {"type": "string", "minLength": 1}, "supervision_capability_sha256": {"$ref": "#/$defs/sha256"},
        "envelope_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "suspension_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "request_id", "idempotency_key", "supervision_invocation_id", "launch_generation", "envelope_sha256", "supervision_capability_id", "supervision_capability_sha256", "force_fence_id", "force_fence_sha256", "api_run_id", "job_id", "attempt_id", "lease_id", "native_run_id", "command_kind", "command_sha256", "executable_workspace_root_sha256", "control_root_sha256", "admission_checkpoint_basis_sha256", "actor_id", "reason_code", "environment", "emergency_containment_confirmed", "requested_at", "expires_at", "grace_deadline", "request_sha256"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_suspension_request.v1"}, "operation": {"const": "cooperative_suspend"},
        "request_id": {"type": "string", "minLength": 1}, "idempotency_key": {"type": "string", "minLength": 1},
        "supervision_invocation_id": {"type": "string", "minLength": 1}, "launch_generation": {"type": "integer", "minimum": 1},
        "envelope_sha256": {"$ref": "#/$defs/sha256"}, "supervision_capability_id": {"type": "string", "minLength": 1},
        "supervision_capability_sha256": {"$ref": "#/$defs/sha256"}, "force_fence_id": {"type": "string", "minLength": 1},
        "force_fence_sha256": {"$ref": "#/$defs/sha256"}, "api_run_id": {"type": "string", "minLength": 1},
        "job_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
        "lease_id": {"type": "string", "minLength": 1}, "native_run_id": {"type": "string", "minLength": 1},
        "command_kind": {"enum": ["external_authority_v2_dispatch", "provider_reconciliation"]}, "command_sha256": {"$ref": "#/$defs/sha256"},
        "executable_workspace_root_sha256": {"$ref": "#/$defs/sha256"}, "control_root_sha256": {"$ref": "#/$defs/sha256"},
        "admission_checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"}, "actor_id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1},
        "emergency_containment_confirmed": {"const": true}, "requested_at": {"type": "string"},
        "expires_at": {"type": "string"}, "grace_deadline": {"type": "string"}, "request_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "suspension_result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "result_id", "result_sha256", "request_id", "request_sha256", "supervision_invocation_id", "envelope_sha256", "supervision_capability_id", "supervision_capability_sha256", "force_fence_id", "force_fence_sha256", "native_publication_invocation_id", "native_run_id", "logical_workspace_root_sha256", "command_kind", "safe_point", "observed_at", "admission_checkpoint_basis_sha256", "observed_checkpoint", "post_publication_checkpoint", "provider_boundary", "local_work_posture", "actions", "ordinary_result_preceded_observation", "outcome", "reason_code", "continuation_mode", "next_safe_point", "continuation_deadline"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_suspension_result.v1"}, "result_id": {"type": "string", "pattern": "^nsusp_[0-9a-f]{24}$"},
        "result_sha256": {"$ref": "#/$defs/sha256"}, "request_id": {"type": "string"}, "request_sha256": {"$ref": "#/$defs/sha256"},
        "supervision_invocation_id": {"type": "string"}, "envelope_sha256": {"$ref": "#/$defs/sha256"},
        "supervision_capability_id": {"type": "string"}, "supervision_capability_sha256": {"$ref": "#/$defs/sha256"},
        "force_fence_id": {"type": "string"}, "force_fence_sha256": {"$ref": "#/$defs/sha256"},
        "native_publication_invocation_id": {"type": "string"}, "native_run_id": {"type": "string"},
        "logical_workspace_root_sha256": {"$ref": "#/$defs/sha256"}, "command_kind": {"enum": ["external_authority_v2_dispatch", "provider_reconciliation"]},
        "safe_point": {"enum": ["dispatch_after_intent_checkpoint", "dispatch_before_provider_post", "dispatch_after_provider_return", "dispatch_after_identity_checkpoint", "reconciliation_before_provider_get", "reconciliation_after_response_checkpoint", "reconciliation_before_local_adoption", "reconciliation_after_adoption_checkpoint", "reconciliation_before_result_publication"]}, "observed_at": {"type": "string"}, "admission_checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
        "observed_checkpoint": {"$ref": "#/$defs/checkpoint"}, "post_publication_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "provider_boundary": {"enum": ["not_entered", "known_provider_identity", "completed_provider_evidence", "entry_or_result_ambiguous"]},
        "local_work_posture": {"enum": ["none", "durable_pending", "completed_unadopted", "adopted_checkpointed", "ambiguous"]},
        "actions": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/action"}}, "ordinary_result_preceded_observation": {"const": false},
        "outcome": {"enum": ["suspended_checkpointed", "suspended_quiescent_no_checkpoint_change", "suspension_deferred", "suspension_refused", "provider_boundary_ambiguous", "checkpoint_publication_ambiguous"]}, "reason_code": {"type": "string"},
        "continuation_mode": {"oneOf": [{"enum": ["continue_to_named_safe_point", "exit_after_result_publication", "await_separate_api_action"]}, {"type": "null"}]}, "next_safe_point": {"type": ["string", "null"]},
        "continuation_deadline": {"type": ["string", "null"]}
      }
    },
    "suspension_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "receipt_id", "receipt_sha256", "supervision_invocation_id", "native_run_id", "result_id", "result_sha256", "request_id", "request_sha256", "supervision_capability_id", "supervision_capability_sha256", "force_fence_id", "force_fence_sha256", "checkpoint_basis_sha256", "snapshot_sha256", "published_at"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_suspension_receipt.v1"}, "receipt_id": {"type": "string", "pattern": "^nsuspr_[0-9a-f]{24}$"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}, "supervision_invocation_id": {"type": "string"}, "native_run_id": {"type": "string"},
        "result_id": {"type": "string"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "request_id": {"type": "string"},
        "request_sha256": {"$ref": "#/$defs/sha256"}, "supervision_capability_id": {"type": "string"},
        "supervision_capability_sha256": {"$ref": "#/$defs/sha256"}, "force_fence_id": {"type": "string"},
        "force_fence_sha256": {"$ref": "#/$defs/sha256"}, "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"}, "published_at": {"type": "string"}
      }
    },
    "command_result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "command_result_sha256", "outcome", "exit_code", "supervision_invocation_id", "supervision_capability_id", "supervision_capability_sha256", "force_fence_id", "force_fence_sha256", "native_publication_invocation_id", "result_id", "result_sha256", "receipt_id", "receipt_sha256", "checkpoint_basis_sha256"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_suspension_command_result.v1"}, "command_result_sha256": {"$ref": "#/$defs/sha256"},
        "outcome": {"type": "string"}, "exit_code": {"enum": [0, 2]}, "supervision_invocation_id": {"type": "string"},
        "supervision_capability_id": {"type": "string"}, "supervision_capability_sha256": {"$ref": "#/$defs/sha256"},
        "force_fence_id": {"type": "string"}, "force_fence_sha256": {"$ref": "#/$defs/sha256"},
        "native_publication_invocation_id": {"type": "string"}, "result_id": {"type": "string"}, "result_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_id": {"type": "string"}, "receipt_sha256": {"$ref": "#/$defs/sha256"}, "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture_case": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "envelope", "request", "result", "receipt", "command_result"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "envelope": {"$ref": "#/$defs/supervision_invocation"},
        "request": {"$ref": "#/$defs/suspension_request"},
        "result": {"$ref": "#/$defs/suspension_result"},
        "receipt": {"$ref": "#/$defs/suspension_receipt"},
        "command_result": {"$ref": "#/$defs/command_result"}
      }
    },
    "fixture_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "bundle_sha256", "cases"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_suspension_fixture_bundle.v1"},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture_case"}}
      }
    }
  }
}
