{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.external_authority_grant.v2",
  "type": "object",
  "required": [
    "schema_version", "grant_sha256", "decision", "api_decision_id", "issuer",
    "issued_at", "external_authority_request_sha256", "run_id",
    "checkpoint_basis_sha256", "request_schema_version", "request_kind", "ordering_semantics",
    "route_family", "provider_mechanism", "action_count",
    "ordered_action_ids", "ordered_member_authorizations"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.external_authority_grant.v2"},
    "grant_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {"const": "granted"},
    "api_decision_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "issued_at": {"$ref": "#/$defs/canonicalUtc"},
    "external_authority_request_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint_basis_sha256": {"$ref": "#/$defs/sha256"},
    "request_schema_version": {"const": "astrowoof.external_authority_request.v2"},
    "request_kind": {"const": "ordinary_action_set"},
    "ordering_semantics": {"const": "lexical_action_id_ascending"},
    "route_family": {"enum": ["exact_natal", "bounded_natal"]},
    "provider_mechanism": {"enum": ["response", "batch"]},
    "action_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "ordered_action_ids": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/$defs/actionId"}
    },
    "ordered_member_authorizations": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actionId": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"},
    "canonicalUtc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "member": {
      "type": "object",
      "required": ["action_id", "binding_sha256", "authorization_document_sha256", "authorization_reference"],
      "properties": {
        "action_id": {"$ref": "#/$defs/actionId"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_document_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_reference": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
