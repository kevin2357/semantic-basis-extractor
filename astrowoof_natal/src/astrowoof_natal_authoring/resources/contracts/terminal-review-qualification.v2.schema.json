{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.terminal_review_qualification.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "qualification", "publication_identity", "receipt_sha256"],
  "properties": {
    "schema_version": {"const": "astrowoof.terminal_review_qualification.v2"},
    "status": {"const": "pass"},
    "qualification": {"type": "object"},
    "publication_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "result_sha256", "receipt_id", "receipt_sha256", "snapshot_sha256", "checkpoint_basis_sha256", "terminal_outcome", "terminal_cause", "custody_finality", "reconciliation_action_ids"],
      "properties": {
        "result_id": {"type": "string", "pattern": "^nres_[0-9a-f]{24}$"},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_id": {"type": "string", "pattern": "^nreceipt_[0-9a-f]{24}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint_basis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "terminal_outcome": {"const": "review_required"},
        "terminal_cause": {"type": "string", "minLength": 1},
        "custody_finality": {"const": "mixed_resolution_required"},
        "reconciliation_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}}
      }
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
