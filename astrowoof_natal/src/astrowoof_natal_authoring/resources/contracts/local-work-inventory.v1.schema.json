{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astrowoof.local_work_inventory.v1",
  "type": "object",
  "required": [
    "schema_version", "run_id", "state_revision", "snapshot_sha256",
    "logical_workspace_root", "ordering_semantics", "operations",
    "consumed_operation_keys", "inventory_sha256"
  ],
  "properties": {
    "schema_version": {"const": "astrowoof.local_work_inventory.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "state_revision": {"type": "integer", "minimum": 0},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_workspace_root": {"type": "string", "minLength": 1},
    "ordering_semantics": {"const": "sbe_selected_execution_order"},
    "operations": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "operation_id", "operation_key", "kind", "route_family", "stage",
          "source_action_ids", "reason_code", "basis_state_revision",
          "basis_snapshot_sha256"
        ],
        "properties": {
          "operation_id": {"type": "string", "pattern": "^local_[0-9a-f]{24}$"},
          "operation_key": {"type": "string", "pattern": "^work_[0-9a-f]{24}$"},
          "kind": {"enum": [
            "provider_result_fan_in_and_retry_evaluation",
            "final_assembly_and_qa", "delivery_construction"
          ]},
          "route_family": {"enum": ["exact_natal", "bounded_natal"]},
          "stage": {"enum": [
            "authoring_initial", "creative_retry", "polish",
            "qualitative_critic", "qualitative_candidate", null
          ]},
          "source_action_ids": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^paid_[0-9a-f]{24}$"}
          },
          "reason_code": {"enum": [
            "provider_evidence_ingestion_required", "final_assembly_required",
            "delivery_not_constructed"
          ]},
          "basis_state_revision": {"type": "integer", "minimum": 0},
          "basis_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "consumed_operation_keys": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^work_[0-9a-f]{24}$"}
    },
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
