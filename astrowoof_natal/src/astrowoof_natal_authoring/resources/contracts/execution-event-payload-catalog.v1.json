    "bounded.admission.completed": {"required_fields": ["admission_id", "input_contract"]},
    "bounded.family.validated": {"required_fields": ["context_count", "certainty_class"]},
    "bounded.selection.completed": {"required_fields": ["claim_count", "selection_contract"]},
    "bounded.disposition.completed": {"required_fields": ["selected_count", "suppressed_count"]},
