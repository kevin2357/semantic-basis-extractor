    "external_authority.intent_committed": {"required_fields": ["request_sha256", "grant_sha256", "action_count", "state_revision"]},
    "external_authority.provider_create_permitted": {"required_fields": ["request_sha256", "action_count", "selected_command"]},
    "external_authority.refused": {"required_fields": ["reason_code", "category", "selected_command", "action_count"]},
    "qa.started": {"required_fields": ["scope", "attempt"]},
