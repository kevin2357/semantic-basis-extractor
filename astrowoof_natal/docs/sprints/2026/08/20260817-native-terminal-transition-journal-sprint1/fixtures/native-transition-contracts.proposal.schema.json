{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.example/sbe/native-transition-contracts.proposal.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/journal_record"},
    {"$ref": "#/$defs/execution_result"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$", "maxLength": 40},
    "route_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_family", "provider_mechanism", "native_operation_ref"],
      "properties": {
        "route_family": {"enum": ["exact_natal", "bounded_natal"]},
        "provider_mechanism": {"enum": ["response", "batch"]},
        "native_operation_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "action_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "stage", "route", "request_sha256", "profile_sha256", "maximum_output_tokens", "commitment_micro_usd", "price_book_version"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "stage": {"enum": ["authoring_initial", "creative_retry", "polish", "qualitative_critic", "qualitative_candidate"]},
        "route": {"type": "string", "minLength": 1, "maxLength": 256},
        "request_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "maximum_output_tokens": {"type": "integer", "minimum": 1},
        "commitment_micro_usd": {"type": "integer", "minimum": 0},
        "price_book_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "provider_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_kind", "provider_kind", "provider_operation_id", "status", "cost_disposition", "price_book_version", "usage_evidence_ref", "estimated_micro_usd"],
      "properties": {
        "observation_kind": {"enum": ["submission_started", "identity_recorded", "pending", "completed", "failed", "cancelled", "expired", "usage_reported", "usage_unavailable", "submission_ambiguous", "identity_conflict_refused"]},
        "provider_kind": {"enum": ["response", "batch"]},
        "provider_operation_id": {"type": ["string", "null"], "maxLength": 256},
        "status": {"type": "string", "minLength": 1, "maxLength": 64},
        "cost_disposition": {"enum": ["provider_usage_reported", "provider_usage_unavailable_billing_reconciliation_pending", "no_provider_work_consumed", "not_applicable_provider_pending"]},
        "price_book_version": {"type": ["string", "null"], "maxLength": 64},
        "usage_evidence_ref": {"type": ["object", "null"]},
        "estimated_micro_usd": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"observation_kind": {"const": "submission_started"}}},
          "then": {"properties": {"provider_operation_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"observation_kind": {"enum": ["identity_recorded", "pending", "completed", "failed", "cancelled", "expired", "usage_reported", "usage_unavailable"]}}},
          "then": {"properties": {"provider_operation_id": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {"properties": {"cost_disposition": {"const": "provider_usage_reported"}}},
          "then": {
            "properties": {
              "price_book_version": {"type": "string", "minLength": 1},
              "usage_evidence_ref": {"type": "object"},
              "estimated_micro_usd": {"type": "integer", "minimum": 0}
            }
          },
          "else": {
            "properties": {
              "estimated_micro_usd": {"type": "null"}
            }
          }
        }
      ]
    },
    "journal_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "record_id", "record_sha256", "run_id", "invocation_id", "sequence", "previous_record_sha256", "observed_at", "native_state_revision", "record_kind", "route_binding", "action_binding", "provider_observation", "native_transition"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_transition_journal_record.v0.1"},
        "record_id": {"type": "string", "pattern": "^ntr_[0-9a-f]{24}$"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "invocation_id": {"type": "string", "pattern": "^ninv_[0-9a-f]{24}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "previous_record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "observed_at": {"$ref": "#/$defs/utc"},
        "native_state_revision": {"type": "integer", "minimum": 0},
        "record_kind": {"enum": ["invocation.started", "action.prepared", "action.authorized", "action.consumed", "action.denied_providerless", "provider.submission_started", "provider.identity_recorded", "provider.pending", "provider.completed", "provider.failed", "provider.cancelled", "provider.expired", "provider.usage_reported", "provider.usage_unavailable", "provider.submission_ambiguous", "provider.identity_conflict_refused", "native.transitioned", "invocation.closed"]},
        "route_binding": {"$ref": "#/$defs/route_binding"},
        "action_binding": {"oneOf": [{"$ref": "#/$defs/action_binding"}, {"type": "null"}]},
        "provider_observation": {"oneOf": [{"$ref": "#/$defs/provider_observation"}, {"type": "null"}]},
        "native_transition": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"record_kind": {"pattern": "^provider\\."}}},
          "then": {
            "properties": {
              "action_binding": {"$ref": "#/$defs/action_binding"},
              "provider_observation": {"$ref": "#/$defs/provider_observation"},
              "native_transition": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"record_kind": {"const": "native.transitioned"}}},
          "then": {
            "properties": {
              "provider_observation": {"type": "null"},
              "native_transition": {"type": "object"}
            }
          }
        }
      ]
    },
    "execution_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_id", "result_sha256", "invocation_id", "run_id", "sbe_release", "published_at", "command_kind", "route_binding", "pre_checkpoint", "post_checkpoint", "journal_range", "outcome", "cause_code", "action_ids", "provider_operations", "projection_refs"],
      "properties": {
        "schema_version": {"const": "astrowoof.native_execution_result.v0.1"},
        "result_id": {"type": "string", "pattern": "^nres_[0-9a-f]{24}$"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "invocation_id": {"type": "string", "pattern": "^ninv_[0-9a-f]{24}$"},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "sbe_release": {"type": "string", "minLength": 1, "maxLength": 32},
        "published_at": {"$ref": "#/$defs/utc"},
        "command_kind": {"enum": ["ordinary_authoring", "provider_reconciliation"]},
        "route_binding": {"$ref": "#/$defs/route_binding"},
        "pre_checkpoint": {"type": ["object", "null"]},
        "post_checkpoint": {"type": "object"},
        "journal_range": {"type": "object"},
        "outcome": {"enum": ["delivery_complete", "review_required", "terminal_failure", "provider_pending", "continuation_required", "awaiting_external_authority", "budget_exhausted", "policy_stopped", "ambiguous_submission", "native_evidence_invalid"]},
        "cause_code": {"enum": ["delivery_complete", "delivery_complete_with_warnings", "final_qa_requires_review", "authoring_attempts_exhausted", "provider_terminal_failure", "provider_output_invalid", "provider_identity_conflict", "provider_operation_pending", "local_continuation_ready", "spend_authorization_required", "external_spend_authority_denied", "native_budget_ceiling_exhausted", "external_product_policy_denied", "ambiguous_provider_submission", "snapshot_or_journal_invalid", "unsupported_route_or_legacy_evidence"]},
        "action_ids": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 128}},
        "provider_operations": {"type": "array", "maxItems": 128, "items": {"type": "object"}},
        "projection_refs": {"type": "object"}
      }
    }
  }
}
