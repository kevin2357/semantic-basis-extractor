{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrowoof.local/schema/projected-natal-authoring-packet-v0.3.json",
  "title": "AstroWoof Projected Natal Authoring Packet",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "subject",
    "source",
    "coverage",
    "statistics",
    "categories",
    "behavioral_domains",
    "context_filter_groups",
    "whole_graph_analysis",
    "summary",
    "cards",
    "unselected_claims",
    "projected_term_registry"
  ],
  "properties": {
    "schema_version": {
      "const": "astrowoof.projected_natal_cards.authoring_packet.v0.3"
    },
    "generator": {
      "type": "object",
      "required": [
        "semantic_basis_extractor",
        "candidate_generator",
        "optimizer",
        "editorial_status"
      ]
    },
    "subject": {
      "type": "object",
      "required": ["subject_id", "display_name", "subject_type", "pronouns"]
    },
    "source": {
      "type": "object",
      "required": [
        "source_graph_ref",
        "source_identity",
        "contexts",
        "source_hashes",
        "input_files",
        "registry_merge"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "projected_object_count",
        "projected_relationship_count",
        "selected_claim_count",
        "unselected_claim_count",
        "guardrails"
      ]
    },
    "statistics": {
      "type": "object",
      "required": [
        "total_claims",
        "mandatory_claims",
        "claim_type_counts",
        "unselected_claims",
        "maximal_support_variants",
        "editorial_placeholders"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "behavioral_domains": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "context_filter_groups": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/contextFilterDefinition"}
    },
    "whole_graph_analysis": {"type": "object"},
    "summary": {
      "type": "object",
      "required": ["card1", "card2", "card3", "card4"],
      "properties": {
        "card1": {"$ref": "#/$defs/summaryCard"},
        "card2": {"$ref": "#/$defs/summaryCard"},
        "card3": {"$ref": "#/$defs/summaryCard"},
        "card4": {"$ref": "#/$defs/summaryCard"}
      },
      "additionalProperties": false
    },
    "cards": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/selectedClaim"}
    },
    "unselected_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/unselectedClaim"}
    },
    "projected_term_registry": {
      "type": "object",
      "required": [
        "registry_id",
        "registry_version",
        "target_ontology",
        "materialization",
        "terms"
      ],
      "properties": {
        "terms": {"type": "object"}
      }
    }
  },
  "$defs": {
    "voiceMap": {
      "type": "object",
      "required": ["handler", "direct_to_dog", "hybrid"],
      "properties": {
        "handler": {"type": "string", "minLength": 1},
        "direct_to_dog": {"type": "string", "minLength": 1},
        "hybrid": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "densityRendering": {
      "type": "object",
      "required": ["headline", "body"],
      "properties": {
        "headline": {"$ref": "#/$defs/voiceMap"},
        "body": {"$ref": "#/$defs/voiceMap"}
      },
      "additionalProperties": false
    },
    "textArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "editorialCard": {
      "type": "object",
      "required": [
        "funny_dog_quotes",
        "imperative_dog_quotes",
        "applicable_canine_jokes",
        "no_astro",
        "light_astro",
        "full_astro"
      ],
      "properties": {
        "funny_dog_quotes": {"$ref": "#/$defs/textArray"},
        "imperative_dog_quotes": {"$ref": "#/$defs/textArray"},
        "applicable_canine_jokes": {"$ref": "#/$defs/textArray"},
        "no_astro": {"$ref": "#/$defs/densityRendering"},
        "light_astro": {"$ref": "#/$defs/densityRendering"},
        "full_astro": {"$ref": "#/$defs/densityRendering"}
      },
      "additionalProperties": false
    },
    "summaryCard": {
      "type": "object",
      "required": [
        "dos",
        "donts",
        "funny_dog_quotes",
        "imperative_dog_quotes",
        "applicable_canine_jokes",
        "no_astro",
        "light_astro",
        "full_astro"
      ],
      "properties": {
        "dos": {"$ref": "#/$defs/textArray"},
        "donts": {"$ref": "#/$defs/textArray"},
        "funny_dog_quotes": {"$ref": "#/$defs/textArray"},
        "imperative_dog_quotes": {"$ref": "#/$defs/textArray"},
        "applicable_canine_jokes": {"$ref": "#/$defs/textArray"},
        "no_astro": {"$ref": "#/$defs/densityRendering"},
        "light_astro": {"$ref": "#/$defs/densityRendering"},
        "full_astro": {"$ref": "#/$defs/densityRendering"}
      },
      "additionalProperties": false
    },
    "contextFilterDefinition": {
      "type": "object",
      "required": ["name", "level"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "level": {"enum": ["high", "detail"]}
      },
      "additionalProperties": false
    },
    "contextFilterAssignments": {
      "type": "object",
      "required": ["high_level", "detail_level"],
      "properties": {
        "high_level": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "detail_level": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "selectedClaim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "categories",
        "context_filter_groups",
        "canonical_claim",
        "importance",
        "confidence",
        "strength",
        "priority_id",
        "selection",
        "behavioral_domains",
        "tags",
        "evidence",
        "relations",
        "dos",
        "donts",
        "card"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "minLength": 1},
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "theme_group": {"type": "string", "minLength": 1},
        "context_filter_groups": {
          "$ref": "#/$defs/contextFilterAssignments"
        },
        "canonical_claim": {"type": "string", "minLength": 1},
        "importance": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "strength": {"type": "number", "minimum": 0, "maximum": 1},
        "priority_id": {"type": "integer", "minimum": 1, "maximum": 50},
        "selection": {"type": "object"},
        "behavioral_domains": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "relations": {
          "type": "object",
          "required": ["reinforces", "tensions_with", "related_claims"]
        },
        "dos": {"$ref": "#/$defs/textArray"},
        "donts": {"$ref": "#/$defs/textArray"},
        "card": {"$ref": "#/$defs/editorialCard"}
      },
      "additionalProperties": false
    },
    "unselectedClaim": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "candidate_type",
        "categories",
        "canonical_claim",
        "dependencies",
        "source_refs",
        "behavioral_domains",
        "tags",
        "evidence",
        "score_components",
        "total_score",
        "provenance",
        "selection"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "minLength": 1},
        "candidate_type": {"type": "string", "minLength": 1},
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "variant_of": {"type": "string", "minLength": 1},
        "variant_kind": {"type": "string", "minLength": 1},
        "additional_supporting_claim_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "canonical_claim": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "behavioral_domains": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object"}
        },
        "score_components": {"type": "object"},
        "total_score": {"type": "number"},
        "provenance": {"type": "object"},
        "selection": {
          "type": "object",
          "required": [
            "selected",
            "eligible_for_selection",
            "rejection_reason",
            "selected_dependency_ids",
            "unselected_dependency_ids"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
